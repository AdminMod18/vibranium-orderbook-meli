<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Vibranium Order Book - CARGA" enabled="true"><stringProp name="TestPlan.comments">Plan de carga. Orden: línea base -&gt; fondeo -&gt; carga -&gt; auditoría de conservación. Todo se parametriza con -J (host, port, threads, rampup, duration, tps, users, mid_price, spread, cancel_pct, with_history).</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="host" elementType="Argument"><stringProp name="Argument.name">host</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="port" elementType="Argument"><stringProp name="Argument.name">port</stringProp><stringProp name="Argument.value">${__P(port,8080)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="protocol" elementType="Argument"><stringProp name="Argument.name">protocol</stringProp><stringProp name="Argument.value">${__P(protocol,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="threads" elementType="Argument"><stringProp name="Argument.name">threads</stringProp><stringProp name="Argument.value">${__P(threads,128)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="rampup" elementType="Argument"><stringProp name="Argument.name">rampup</stringProp><stringProp name="Argument.value">${__P(rampup,30)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="duration" elementType="Argument"><stringProp name="Argument.name">duration</stringProp><stringProp name="Argument.value">${__P(duration,600)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="tps" elementType="Argument"><stringProp name="Argument.name">tps</stringProp><stringProp name="Argument.value">${__P(tps,5000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="users" elementType="Argument"><stringProp name="Argument.name">users</stringProp><stringProp name="Argument.value">${__P(users,100)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="mid_price" elementType="Argument"><stringProp name="Argument.name">mid_price</stringProp><stringProp name="Argument.value">${__P(mid_price,10000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="spread" elementType="Argument"><stringProp name="Argument.name">spread</stringProp><stringProp name="Argument.value">${__P(spread,50)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="cancel_pct" elementType="Argument"><stringProp name="Argument.name">cancel_pct</stringProp><stringProp name="Argument.value">${__P(cancel_pct,3)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="with_history" elementType="Argument"><stringProp name="Argument.name">with_history</stringProp><stringProp name="Argument.value">${__P(with_history,false)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="fund_brl" elementType="Argument"><stringProp name="Argument.name">fund_brl</stringProp><stringProp name="Argument.value">${__P(fund_brl,100000000000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="fund_vib" elementType="Argument"><stringProp name="Argument.name">fund_vib</stringProp><stringProp name="Argument.value">${__P(fund_vib,100000000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="connect_timeout_ms" elementType="Argument"><stringProp name="Argument.name">connect_timeout_ms</stringProp><stringProp name="Argument.value">${__P(connect_timeout_ms,3000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="response_timeout_ms" elementType="Argument"><stringProp name="Argument.name">response_timeout_ms</stringProp><stringProp name="Argument.value">${__P(response_timeout_ms,10000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp></TestPlan><hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor bajo prueba (host, port, protocol)" enabled="true"><stringProp name="HTTPSampler.domain">${host}</stringProp><stringProp name="HTTPSampler.port">${port}</stringProp><stringProp name="HTTPSampler.protocol">${protocol}</stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path"></stringProp><stringProp name="HTTPSampler.implementation">HttpClient4</stringProp><stringProp name="HTTPSampler.connect_timeout">${connect_timeout_ms}</stringProp><stringProp name="HTTPSampler.response_timeout">${response_timeout_ms}</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp></ConfigTestElement><hashTree></hashTree><SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Preparación (línea base y fondeo)" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration">0</stringProp><stringProp name="ThreadGroup.delay">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></SetupThreadGroup><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras JSON" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SETUP GET /audit (línea base)" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/audit</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Fijar run_id único" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">pre_runid</stringProp><stringProp name="script">
// Un identificador único por ejecución: evita colisiones de idempotencia entre corridas (los ids de orden se recuerdan
// en una ventana de 5 M) y permite reconocer, y no mezclar, los datos que creó esta prueba.
if (props.getProperty('run_id') == null || props.getProperty('run_id').isEmpty()) {
  props.setProperty('run_id', new Date().format('yyyyMMddHHmmss') + Integer.toString(new Random().nextInt(0x10000), 16).padLeft(4, '0'))
}
</stringProp></JSR223PreProcessor><hashTree></hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Guardar totales base" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">post_base</stringProp><stringProp name="script">
// Línea base de la auditoría ANTES de fondear: al final, el total debe ser base + lo depositado (conservación bajo carga).
// Es válido si nadie más deposita durante la prueba (ver README: no usar contra un sistema con otros clientes).
if (prev.getResponseCode() == '200') {
  def a = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
  props.setProperty('base_brl', a.total_brl.toString()); props.setProperty('base_vib', a.total_vib.toString())
}
</stringProp></JSR223PostProcessor><hashTree></hashTree></hashTree><LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="fund" enabled="true"><boolProp name="LoopController.continue_forever">true</boolProp><stringProp name="LoopController.loops">${users}</stringProp></LoopController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SETUP POST /deposits" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;user_id&quot;:&quot;${fundUser}&quot;,&quot;brl&quot;:${fund_brl},&quot;vib&quot;:${fund_vib}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/deposits</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Usuario a fondear" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">pre_fund</stringProp><stringProp name="script">
String run = props.getProperty('run_id')
vars.put('fundUser', &quot;jm&quot; + String.valueOf(run) + &quot;-u&quot; + String.valueOf(vars.get('__jm__fund__idx')) + &quot;&quot;)
</stringProp></JSR223PreProcessor><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="204" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_204</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()
if (code != '204') fail('depósito: esperado 204, recibido ' + code + ' ' + text)
</stringProp></JSR223Assertion><hashTree></hashTree></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Carga de órdenes" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${threads}</stringProp><stringProp name="ThreadGroup.ramp_time">${rampup}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${duration}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras JSON" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /orders" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;id&quot;:&quot;${orderId}&quot;,&quot;user_id&quot;:&quot;${userId}&quot;,&quot;side&quot;:&quot;${side}&quot;,&quot;price&quot;:${price},&quot;qty&quot;:${qty}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/orders</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generar orden única" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">pre_order</stringProp><stringProp name="script">
// Genera una orden válida y única: id = jm&lt;run&gt;-&lt;hilo&gt;-&lt;n&gt;. Precio en centavos alrededor del precio medio; así hay cruces y parciales.
def rnd = java.util.concurrent.ThreadLocalRandom.current()
int users = ((vars.get('users') ?: props.getProperty('users') ?: '100')) as int
long mid = ((vars.get('mid_price') ?: props.getProperty('mid_price') ?: '10000')) as long
long spread = ((vars.get('spread') ?: props.getProperty('spread') ?: '50')) as long
String run = props.getProperty('run_id')
long n = vars.getIteration()
vars.put('orderId', &quot;jm&quot; + String.valueOf(run) + &quot;-&quot; + String.valueOf(ctx.getThreadNum()) + &quot;-&quot; + String.valueOf(n) + &quot;&quot;)
vars.put('userId', &quot;jm&quot; + String.valueOf(run) + &quot;-u&quot; + String.valueOf(rnd.nextInt(users)) + &quot;&quot;)
vars.put('side', rnd.nextBoolean() ? 'BUY' : 'SELL')
vars.put('price', Long.toString(mid + rnd.nextLong(2 * spread + 1) - spread))
vars.put('qty', Long.toString(1 + rnd.nextInt(10)))
vars.put('lastId', &quot;jm&quot; + String.valueOf(run) + &quot;-&quot; + String.valueOf(ctx.getThreadNum()) + &quot;-&quot; + String.valueOf(n) + &quot;&quot;); vars.put('lastStatus', '')
</stringProp></JSR223PreProcessor><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar orden: código, coherencia y trades" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_order</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()

// POST /orders válido: debe ser 201 y el cuerpo debe ser coherente consigo mismo y con lo enviado.
if (code != '201') { fail(&quot;esperado 201, recibido &quot; + code + &quot; &quot; + (text.length() &gt; 120 ? text.substring(0, 120) : text)); return }
def r = new JsonSlurper().parseText(text)
def o = r.order
if (o == null) { fail(&quot;sin 'order' en la respuesta&quot;); return }
def id = vars.get('orderId'); def side = vars.get('side')
long price = vars.get('price') as long; long qty = vars.get('qty') as long
if (o.id != id) { fail(&quot;id devuelto &quot; + String.valueOf(o.id) + &quot; != enviado &quot; + String.valueOf(id) + &quot;&quot;); return }
if (o.user_id != vars.get('userId') || o.side != side || o.price != price || o.qty != qty) { fail(&quot;la orden devuelta no coincide con la enviada&quot;); return }
if (o.filled &lt; 0 || o.filled &gt; o.qty || o.filled + o.remaining != o.qty) { fail(&quot;filled+remaining != qty: &quot; + String.valueOf(o.filled) + &quot;+&quot; + String.valueOf(o.remaining) + &quot; vs &quot; + String.valueOf(o.qty) + &quot;&quot;); return }
def trades = r.trades ?: []
long sum = 0
for (t in trades) {
  sum += t.qty
  if (t.taker_order_id != id) { fail(&quot;trade con taker &quot; + String.valueOf(t.taker_order_id) + &quot; != &quot; + String.valueOf(id) + &quot;&quot;); return }
  if (t.total != t.price * t.qty) { fail(&quot;trade.total != price*qty&quot;); return }
  if (side == 'BUY') {
    if (t.price &gt; price) { fail(&quot;compra a &quot; + String.valueOf(t.price) + &quot; &gt; límite &quot; + String.valueOf(price) + &quot;&quot;); return }
    if (t.buy_order_id != id) { fail(&quot;trade de compra con buy_order_id ajeno&quot;); return }
  } else {
    if (t.price &lt; price) { fail(&quot;venta a &quot; + String.valueOf(t.price) + &quot; &lt; límite &quot; + String.valueOf(price) + &quot;&quot;); return }
    if (t.sell_order_id != id) { fail(&quot;trade de venta con sell_order_id ajeno&quot;); return }
  }
}
if (sum != o.filled) { fail(&quot;suma de trades &quot; + String.valueOf(sum) + &quot; != filled &quot; + String.valueOf(o.filled) + &quot;&quot;); return }
def okStatus = (o.filled == o.qty) ? 'FILLED' : (o.filled == 0 ? 'OPEN' : 'PARTIALLY_FILLED')
if (o.status != okStatus &amp;&amp; o.status != 'CANCELLED') { fail(&quot;status &quot; + String.valueOf(o.status) + &quot; incoherente con filled=&quot; + String.valueOf(o.filled) + &quot;/&quot; + String.valueOf(o.qty) + &quot; (esperado &quot; + String.valueOf(okStatus) + &quot;)&quot;); return }
vars.put('lastStatus', o.status)
vars.put('lastId', id)
</stringProp></JSR223Assertion><hashTree></hashTree><ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Tasa objetivo de órdenes/s (-Jtps; 0 = sin tope)" enabled="true"><intProp name="calcMode">4</intProp><stringProp name="throughput">${__jexl3(${tps} &gt; 0 ? ${tps} * 60 : 60000000)}</stringProp></ConstantThroughputTimer><hashTree></hashTree></hashTree><ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Cancelar (cancel_pct %)" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><intProp name="ThroughputController.maxThroughput">1</intProp><stringProp name="ThroughputController.percentThroughput">${cancel_pct}</stringProp></ThroughputController><hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Solo si la orden quedó en el libro" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('lastStatus') == 'OPEN' || vars.get('lastStatus') == 'PARTIALLY_FILLED')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DELETE /orders/{id}" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/orders/${lastId}</stringProp><stringProp name="HTTPSampler.method">DELETE</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar cancelación" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_cancel</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()

// DELETE /orders/{id}: 200 con la orden CANCELLED, o 404 order_not_found si otro hilo la ejecutó antes (carrera legítima).
def r = new JsonSlurper().parseText(text)
if (code == '200') {
  if (r.status != 'CANCELLED' || r.id != vars.get('lastId')) fail(&quot;cancelación incoherente: &quot; + String.valueOf(text) + &quot;&quot;)
} else if (code == '404') {
  prev.setSuccessful(true)   // carrera legítima: otro hilo ya ejecutó/canceló la orden
  if (r.code != 'order_not_found') fail(&quot;404 sin code order_not_found: &quot; + String.valueOf(text) + &quot;&quot;)
} else fail(&quot;esperado 200/404, recibido &quot; + code)
</stringProp></JSR223Assertion><hashTree></hashTree></hashTree></hashTree></hashTree><ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Consultar saldo (4 %)" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><intProp name="ThroughputController.maxThroughput">1</intProp><stringProp name="ThroughputController.percentThroughput">4</stringProp></ThroughputController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /balances/{user}" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/balances/${userId}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar saldo no negativo" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_balance</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()

if (code != '200') { fail(&quot;esperado 200, recibido &quot; + code); return }
def b = new JsonSlurper().parseText(text)
if (b.user_id != vars.get('userId')) { fail(&quot;user_id incorrecto&quot;); return }
if (b.brl_free &lt; 0 || b.brl_held &lt; 0 || b.vib_free &lt; 0 || b.vib_held &lt; 0) fail(&quot;saldo negativo: &quot; + String.valueOf(text) + &quot;&quot;)
</stringProp></JSR223Assertion><hashTree></hashTree></hashTree></hashTree><ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Consultar libro (1 %)" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><intProp name="ThroughputController.maxThroughput">1</intProp><stringProp name="ThroughputController.percentThroughput">1</stringProp></ThroughputController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /book?depth=5" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/book?depth=5</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar libro no cruzado y ordenado" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_book</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()

if (code != '200') { fail(&quot;esperado 200, recibido &quot; + code); return }
def b = new JsonSlurper().parseText(text)
def bids = b.bids ?: []; def asks = b.asks ?: []
for (int i = 1; i &lt; bids.size(); i++) if (bids[i].price &gt;= bids[i-1].price) { fail(&quot;bids no están en orden decreciente&quot;); return }
for (int i = 1; i &lt; asks.size(); i++) if (asks[i].price &lt;= asks[i-1].price) { fail(&quot;asks no están en orden creciente&quot;); return }
if (bids &amp;&amp; asks &amp;&amp; bids[0].price &gt;= asks[0].price) fail(&quot;LIBRO CRUZADO: mejor compra &quot; + String.valueOf(bids[0].price) + &quot; &gt;= mejor venta &quot; + String.valueOf(asks[0].price) + &quot;&quot;)
</stringProp></JSR223Assertion><hashTree></hashTree></hashTree></hashTree><ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="Error esperado: lado inválido -&gt; 400 (0.1 %)" enabled="true"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><intProp name="ThroughputController.maxThroughput">1</intProp><stringProp name="ThroughputController.percentThroughput">0.1</stringProp></ThroughputController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="ERR-ESPERADO lado inválido -&gt; 400" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;user_id&quot;:&quot;${userId}&quot;,&quot;side&quot;:&quot;HOLD&quot;,&quot;price&quot;:10000,&quot;qty&quot;:1}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/orders</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="Tes