ampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/audit</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Invariantes ok y valor conservado" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_audit_final</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()

// Conservación de valor tras toda la carga: el motor no creó ni destruyó dinero ni unidades.
if (code != '200') { fail(&quot;auditoría: esperado 200, recibido &quot; + code + &quot; &quot; + text); return }
def a = new JsonSlurper().parseText(text)
if (a.ok != true) { fail(&quot;INVARIANTES ROTOS: &quot; + text); return }
int users = ((vars.get('users') ?: props.getProperty('users') ?: '100')) as int
long fundBrl = ((vars.get('fund_brl') ?: props.getProperty('fund_brl') ?: '100000000000')) as long
long fundVib = ((vars.get('fund_vib') ?: props.getProperty('fund_vib') ?: '100000000')) as long
long baseBrl = (props.getProperty('base_brl') ?: '0') as long
long baseVib = (props.getProperty('base_vib') ?: '0') as long
long expBrl = baseBrl + users * fundBrl; long expVib = baseVib + users * fundVib
if (a.total_brl != expBrl || a.total_vib != expVib)
  fail(&quot;conservación rota: BRL &quot; + String.valueOf(a.total_brl) + &quot; (esperado &quot; + String.valueOf(expBrl) + &quot;), VIB &quot; + String.valueOf(a.total_vib) + &quot; (esperado &quot; + String.valueOf(expVib) + &quot;)&quot;)
