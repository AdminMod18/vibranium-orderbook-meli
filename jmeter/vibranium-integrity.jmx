</stringProp></JSR223Assertion><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01b GET /book: elegir una banda de precios sin liquidez ajena" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/book?depth=100</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar 01b GET /book: elegir una banda de precios sin liquidez ajena" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_band</stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def fail = { String msg -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msg) }
def code = prev.getResponseCode()
def text = prev.getResponseDataAsString()

// Esta prueba es DETERMINISTA: necesita que ninguna orden ajena se cruce con las suyas. Un comprador con límite P1 se cruza con TODA oferta
// &lt;= P1 y un vendedor con límite P0 con TODA demanda &gt;= P0, así que la banda [P0, P1] debe caer en el hueco entre la mejor compra y la
// mejor venta del libro (o en cualquier lugar si el libro está vacío). Si no hay hueco de al menos 3 centavos, falla con la causa explícita.
if (code != '200') { fail(&quot;GET /book: esperado 200, recibido &quot; + code); return }
def b = new JsonSlurper().parseText(text)
long bestBid = b.bids ? (b.bids.collect { it.price as long }.max()) : 0L
long bestAsk = b.asks ? (b.asks.collect { it.price as long }.min()) : Long.MAX_VALUE
long lo = bestBid + 1
long hi = (bestAsk == Long.MAX_VALUE) ? Math.max(lo + 1000L, 1000000L) : bestAsk - 1
if (hi - lo &lt; 2) {
  fail(&quot;PRECONDICIÓN NO CUMPLIDA: el libro no tiene hueco para aislar esta prueba (mejor compra=&quot; + bestBid + &quot;, mejor venta=&quot; + bestAsk + &quot;). &quot; +
       &quot;Ejecútela con el libro vacío (docker compose down -v &amp;&amp; up -d) o cuando haya al menos 3 centavos entre la mejor compra y la mejor venta.&quot;)
  return
}
long base = ((vars.get('base_price') ?: props.getProperty('base_price') ?: '777000')) as long
long p0 = (base &gt;= lo &amp;&amp; base + 100 &lt;= hi) ? base : lo + (hi - lo).intdiv(3)
long p1 = Math.min(hi, p0 + 100)
if (p1 &lt;= p0) p1 = p0 + 1
vars.put('P0', p0.toString()); vars.put('P1', p1.toString()); vars.put('BRL0', (20L * p1).toString())
</stringProp></JSR223Assertion><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="02 GET /audit (línea base)" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.path">/audit</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp><stringProp name="HTTPSampler.embedded_url_re"></stringProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar 02 GET /audit (línea base)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">assert_a0</stringProp><stringProp name="script">
