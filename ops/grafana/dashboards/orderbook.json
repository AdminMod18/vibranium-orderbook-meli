{
 "uid": "orderbook-overview",
 "title": "Order Book - Visión general",
 "tags": [
  "orderbook"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Órdenes/s aceptadas",
   "description": "Throughput de órdenes que entraron al libro.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(orderbook_orders_total{result=\"accepted\"}[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [],
     "decimals": null
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
